---
import Base from "../layouts/Base.astro";
import { categoryOf, categoryUrl, guideBySlug, guideUrl, guides, guidesIn, pngSize, shotPath } from "../lib/site.ts";
import type { Guide } from "../guides/types.ts";

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}
const { guide } = Astro.props as { guide: Guide };
const cat = categoryOf(guide.category);
const siblings = guidesIn(guide.category);
const idx = siblings.findIndex((g) => g.slug === guide.slug);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const related = (guide.related ?? []).map((s) => guideBySlug.get(s)).filter((g): g is Guide => !!g);
const firstShot = guide.steps.find((s) => s.shot);
const steps = guide.steps.map((s) => {
  const src = s.shot ? shotPath(guide.slug, s.id) : null;
  const size = src ? pngSize(src) : null;
  return { ...s, src: src ? `/${src}` : null, size, mobile: s.shot?.app === "app" || s.shot?.viewport === "mobile" };
});
const jsonLd = {
  "@context": "https://schema.org",
  "@type": guide.steps.length ? "HowTo" : "Article",
  name: guide.title,
  description: guide.description,
  ...(guide.steps.length ? { step: guide.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.title, ...(s.body ? { text: s.body } : {}) })) } : {}),
};
---
<Base title={guide.title} description={guide.description} path={guideUrl(guide.slug)} image={firstShot ? `/${shotPath(guide.slug, firstShot.id)}` : undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="wrap layout">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Help</a></li>
        <li><a href={categoryUrl(cat.id)}>{cat.title}</a></li>
        <li aria-current="page">{guide.title}</li>
      </ol>
    </nav>
    <article class="article">
      <header class="head">
        <p class="eyebrow">{cat.title}</p>
        <h1>{guide.title}</h1>
        <p class="intro">{guide.intro}</p>
        {guide.roles ? <p class="meta"><strong>Who can do this:</strong> {guide.roles}</p> : null}
        {
          guide.setupByOptni ? (
            <aside class="setup" aria-label="Set up by Optni">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 8v5M12 16.5h.01" />
                <circle cx="12" cy="12" r="10" />
              </svg>
              <p>
                <strong>Needs setup by Optni.</strong> {guide.setupByOptni}
              </p>
            </aside>
          ) : null
        }
      </header>

      {
        steps.length ? (
          <section aria-labelledby="steps-title">
            <h2 id="steps-title" class="sr-only">
              Steps
            </h2>
            <ol class="steps">
              {steps.map((s, i) => (
                <li class="step" id={`step-${s.id}`}>
                  <div class="step-text">
                    <span class="step-num" aria-hidden="true">
                      {i + 1}
                    </span>
                    <div>
                      <h3>
                        <span class="sr-only">Step {i + 1}: </span>
                        {s.title}
                      </h3>
                      {s.body ? <p class="muted">{s.body}</p> : null}
                    </div>
                  </div>
                  {s.src && s.size ? (
                    <figure class:list={["shot", { mobile: s.mobile }]}>
                      <img src={s.src} width={s.size.width} height={s.size.height} alt={s.alt ?? s.title} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
                    </figure>
                  ) : null}
                </li>
              ))}
            </ol>
          </section>
        ) : null
      }

      {
        (guide.sections ?? []).map((sec) => (
          <section class="extra">
            <h2>{sec.heading}</h2>
            {(sec.paragraphs ?? []).map((p) => (
              <p>{p}</p>
            ))}
            {sec.bullets ? (
              <ul>
                {sec.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            ) : null}
            {sec.table ? (
              <div class="table-wrap" tabindex="0" role="region" aria-label={sec.heading}>
                <table>
                  {sec.table.caption ? <caption>{sec.table.caption}</caption> : null}
                  <thead>
                    <tr>
                      {sec.table.head.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {sec.table.rows.map((r) => (
                      <tr>{r.map((c, j) => (j === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : null}
            {sec.code ? (
              <figure class="code">
                {sec.code.label ? <figcaption>{sec.code.label}</figcaption> : null}
                <pre tabindex="0" aria-label={sec.code.label ?? "Code example"}><code>{sec.code.text}</code></pre>
              </figure>
            ) : null}
          </section>
        ))
      }

      {
        related.length ? (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">Related guides</h2>
            <ul>
              {related.map((g) => (
                <li>
                  <a href={guideUrl(g.slug)}>{g.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <nav class="pager" aria-label="More in this topic">
        {
          prev ? (
            <a href={guideUrl(prev.slug)} rel="prev">
              <span class="muted">Previous</span>
              {prev.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={guideUrl(next.slug)} rel="next" class="next">
              <span class="muted">Next</span>
              {next.title}
            </a>
          ) : null
        }
      </nav>
    </article>
  </div>
</Base>
<style>
  .layout {
    max-width: 52rem;
    padding-top: 1.5rem;
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 0.35rem;
    color: var(--ink-mute);
  }
  .head {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0 2rem;
  }
  .intro {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .meta {
    font-size: 0.95rem;
  }
  .setup {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--attn) 35%, transparent);
    background: var(--attn-wash);
  }
  .setup svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--attn);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.25rem;
  }
  .step {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .step-text {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .step-text h3 {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
  }
  .step-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 700;
    font-family: var(--font-display);
  }
  .shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .shot img {
    display: block;
    width: 100%;
  }
  .shot.mobile {
    max-width: 300px;
    border-radius: 22px;
    border-width: 6px;
    border-color: var(--ink);
  }
  .extra {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .extra > :global(*) {
    min-width: 0;
  }
  .extra ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
  }
  caption {
    caption-side: bottom;
    text-align: left;
    padding: 0.6rem 0.9rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
  }
  thead th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }
  .code {
    margin: 0;
    min-width: 0;
  }
  .code figcaption {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }
  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    background: var(--code-bg);
    color: var(--code-ink);
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .related {
    margin-top: 2.5rem;
    padding: 1.25rem;
    border-radius: 14px;
    background: var(--brand-wash);
  }
  .related ul {
    margin: 0.6rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }
  .pager {
    margin-top: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pager a {
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    max-width: 100%;
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
  .pager .muted {
    font-size: 0.8rem;
    font-weight: 500;
  }
</style>
