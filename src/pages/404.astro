---
import Base from "../layouts/Base.astro";
import Search from "../components/Search.astro";
---
<Base title="Page not found" description="That help page doesn't exist." path="/404.html" noindex>
  <div class="wrap narrow page">
    <h1>We couldn't find that page</h1>
    <p class="muted">It may have moved. Search for what you need, or go to the <a href="/">help home</a>.</p>
    <Search id="nf-search" />
  </div>
</Base>
<style>
  .page {
    padding-top: 2rem;
    display: grid;
    gap: 1rem;
  }
</style>
