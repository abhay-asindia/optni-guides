---
import Base from "../../layouts/Base.astro";
import { categories, categoryUrl, guideUrl, guidesIn } from "../../lib/site.ts";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { id: c.id }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: (typeof categories)[number] };
const list = guidesIn(cat.id);
---
<Base title={cat.title} description={`${cat.blurb} ${list.length} Optni AI guides.`} path={categoryUrl(cat.id)}>
  <div class="wrap narrow page">
    <nav aria-label="Breadcrumb" class="crumb"><a href="/">Help</a> / {cat.title}</nav>
    <p class="eyebrow">Topic</p>
    <h1>{cat.title}</h1>
    <p class="muted lede">{cat.blurb}</p>
    <ul class="list">
      {
        list.map((g) => (
          <li class="card">
            <a href={guideUrl(g.slug)}>{g.title}</a>
            <p class="muted">{g.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
<style>
  .page {
    padding-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .crumb {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .lede {
    font-size: 1.1rem;
  }
  .list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .list li {
    padding: 1rem 1.1rem;
    display: grid;
    gap: 0.25rem;
  }
  .list a {
    font-weight: 600;
    font-size: 1.05rem;
  }
</style>
